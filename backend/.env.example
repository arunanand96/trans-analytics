# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Postgres connection
DATABASE_URL=postgresql://transport_user:changeme@localhost:5432/transport_analytics

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string

# Where uploaded PDFs are stored on disk (Pass 1). Move to S3-compatible storage later if needed.
UPLOAD_DIR=./uploads

# Comma-separated list of allowed origins for CORS (your React frontend URL)
CORS_ORIGIN=http://localhost:5173
